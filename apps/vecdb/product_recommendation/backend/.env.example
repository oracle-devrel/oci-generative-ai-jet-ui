# VecDB connection configuration
# Copy to .env and replace the placeholder values with real credentials.
VECDB_REST_URL=https://<host>/ords/<schema>/_/db-api/stable/vecdb/
VECDB_USERNAME=<username>
VECDB_PASSWORD=<password>
# Optional: when set, this bearer token takes precedence over username/password.
VECDB_ACCESS_TOKEN=
# Set to true only for a trusted development endpoint with a self-signed TLS certificate.
VECDB_SELF_SIGNED_SSL=false
