# Oracle VecDB connection configuration
# Copy this file to .env and replace the placeholder values.
VECDB_REST_URL=https://<host>/ords/<schema>/_/db-api/stable/vecdb/
VECDB_USERNAME=<username>
VECDB_PASSWORD=<password>
# Optional: when set, this bearer token takes precedence over username/password.
VECDB_ACCESS_TOKEN=
VECDB_TABLE=national_parks
VECDB_EMBED_MODEL=all-MiniLM-L6-v2
# Required by load_parks_vecdb.py when --csv-file is not supplied.
PARKS_CSV_URL=https://<host>/<path>/us_national_parks_dataset_spatial.csv
# Set to true only for a trusted development endpoint with a self-signed TLS certificate.
VECDB_SELF_SIGNED_SSL=false
