# Oracle AI Database 26ai (release 23.26.2 or later for Deep Data Security)
ORACLE_DSN=localhost:1521/FREEPDB1
APPBOOK_DB_USER=MEMORY_APPBOOK
APPBOOK_DB_PASSWORD=MemoryAppbook_12345

# One-time setup: how the appbook creates its schema and the end users. Set one.
ORACLE_CONTAINER=agent-memory-checklist
# ORACLE_ADMIN_PASSWORD=

# Where the ONNX models are cached (the embedder downloads once if missing)
ONNX_MODEL_DIR=~/oracle-models

# Claude: the only call that leaves your machine (plus §2's optional Hugging Face side)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Optional: §2 races the same embedding model on Hugging Face Inference
HF_TOKEN=
