# Use setup.sh to create generated passwords, then configure your chosen models.
HF_DSN=localhost:1523/FREEPDB1
HF_DB_CONTAINER=hf-oracle
HF_DB_PORT=1523
HF_OWNER_PASSWORD=
HF_CREDIT_PASSWORD=
HF_MARKETS_PASSWORD=
HF_DEFAULT_MODEL=openai
HF_REASONING_EFFORT=low
HF_JUDGE_ENABLED=1
HF_JUDGE_MODEL=openai
# Optional: an in-database ONNX cross-encoder (schema.model). Leave empty to keep vector order.
HF_RERANK_MODEL=
PRIVATE_AI_URL=https://127.0.0.1:8443
PRIVATE_AI_MODEL=qwen2.5-3b-instruct-q4_k_m
PRIVATE_AI_API_KEY=
PRIVATE_AI_CA_FILE=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OCI_GENAI_API_KEY=
OCI_GENAI_ENDPOINT=https://inference.generativeai.us-phoenix-1.oci.oraclecloud.com
OCI_GENAI_MODEL=xai.grok-4.3
# Alternative to the API key: OCI SDK config + compartment
OCI_COMPARTMENT_ID=
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT
OCI_INPUT_PRICE=1.25
OCI_OUTPUT_PRICE=2.50
HF_TRUE_CACHE_DSN=
