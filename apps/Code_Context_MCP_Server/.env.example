# Copy to .env and fill in. .env is ignored by git.

# Admin password for the database container (SYS, SYSTEM, PDBADMIN). Used only by compose.yaml.
ORACLE_PWD=change-me-admin
# Application user created in FREEPDB1 on first start.
DB_USER=ccctx
# Application user password. Never printed by any script.
DB_PASSWORD=change-me-app
# Database host. Default localhost.
DB_HOST=localhost
# Database port, also the host port compose.yaml publishes. Default 1521.
DB_PORT=1521
# Pluggable database service name. Default FREEPDB1.
DB_SERVICE=FREEPDB1
# Where sample repositories are cloned, relative to the project root. Must be outside the project.
CCCTX_REPOS_DIR=../ccctx-repos
# Optional: a LiteLLM model string that writes memory fact text, e.g. anthropic/claude-sonnet-5-5 or ollama/qwen3.
# When set, each fact's subject source, findings, related names and question wordings are sent to it. Unset: nothing leaves the database.
# CCCTX_MEMORY_MODEL=
# Optional: base URL of an OpenAI-compatible endpoint for that model.
# CCCTX_MEMORY_MODEL_BASE=
# Optional: API key for that model (otherwise LiteLLM's provider variables, e.g. ANTHROPIC_API_KEY).
# CCCTX_MEMORY_MODEL_KEY=
# Optional: the most usage feedback can raise a result's score, as a fraction (0.2 = 20 percent). 0 to 1; 0 switches feedback off.
# CCCTX_FEEDBACK_CAP=0.2
# Optional: days after which a use counts half as much. Positive. Default 30.
# CCCTX_FEEDBACK_HALF_LIFE_DAYS=30
