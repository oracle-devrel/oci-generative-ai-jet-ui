# Copy this file to .env and replace the placeholders. Do not commit .env.

# VecDB connection. Use either an access token, or username/password.
VECDB_REST_URL=https://<database-host>/ords/vecdb/_/db-api/stable/vecdb/
VECDB_ACCESS_TOKEN=
VECDB_USERNAME=
VECDB_PASSWORD=
VECDB_SELF_SIGNED_SSL=false

# Container engine and Oracle conversion archive.
# Use podman or docker. Download the archive from:
# https://www.oracle.com/database/technologies/oml4py-downloads.html
CONTAINER_CLI=podman
OML4PY_ARCHIVE=/path/to/oml4py-client-linux-x86_64-2.1.1.zip

# Model settings.
MODEL_ID=BAAI/bge-reranker-base
MODEL_NAME=BGE_RERANKER_BASE

# OCI Object Storage. The namespace is discovered automatically.
OCI_CONFIG_FILE=/path/to/oci/config
OCI_PROFILE=DEFAULT
OCI_BUCKET=your-model-bucket
# Leave blank for the tenancy/root compartment, or set an exact child name.
OCI_COMPARTMENT_NAME=
# OCI Generative AI region for the OCI-hosted reranking notebook.
# Rerank 4 Fast is on-demand in us-ashburn-1; Phoenix is dedicated-only.
OCI_GENAI_REGION=us-ashburn-1

# Optional workflow settings.
RERANK_MAX_SEQ_LENGTH=256
RERANK_MODEL_FILE=
RERANK_OBJECT_NAME=
RERANK_PAR_NAME=
RERANK_CONVERSION_IMAGE=mirror.gcr.io/library/python:3.13.5-slim-bookworm
