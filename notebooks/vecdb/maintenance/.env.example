# VecDB connection configuration
# Copy to .env and replace the placeholder values with real credentials.
VECDB_REST_URL=https://<host>/ords/<schema>/_/db-api/stable/vecdb/
VECDB_USERNAME=<username>
VECDB_PASSWORD=<password>
VECDB_SELF_SIGNED_SSL=true
MAINT_TABLE=MAINT_DEMO
ARCHIVE_TABLE=MAINT_ARCHIVE
