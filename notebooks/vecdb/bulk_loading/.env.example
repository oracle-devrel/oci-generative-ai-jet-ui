# VecDB connection configuration
VECDB_REST_URL=https://<host>/ords/<schema>/_/db-api/stable/vecdb/
VECDB_USERNAME=<username>
VECDB_PASSWORD=<password>

# Demo table names
INTEGRATED_TABLE=SUPPORT_AUTO_EMBED
BYO_TABLE_MANUAL=SUPPORT_BYO_IDS
BYO_TABLE_AUTO=SUPPORT_BYO_AUTO_IDS

# Embedding model used for Scenario A (must already exist inside VecDB)
EMBED_MODEL=<vecdb-embedding-model-name>
# Optional legacy support; Scenario A does not auto-loads ONNX artifacts
EMBED_MODEL_URL=

# Signed Object Storage URLs for sample CSV payloads
INTEGRATED_CSV_URL=https://objectstorage.<region>.oraclecloud.com/p/<par>/n/<namespace>/b/<bucket>/o/sample_csv_data/bulktable_integrated_embedding.csv
BYO_MANUAL_CSV_URL=https://objectstorage.<region>.oraclecloud.com/p/<par>/n/<namespace>/b/<bucket>/o/sample_csv_data/bulktable_byov_ids.csv
BYO_AUTO_CSV_URL=https://objectstorage.<region>.oraclecloud.com/p/<par>/n/<namespace>/b/<bucket>/o/sample_csv_data/bulktable_byov_auto_ids.csv
