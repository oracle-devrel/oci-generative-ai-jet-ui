{#- sitp.ai-style notebook page. render_site.py supplies resources.jnb:
    head / top / bottom / scripts (HTML strings) and file (notebook file name).
    Cell tags: remove-cell is applied by TagRemovePreprocessor, hide-input becomes
    `transient.remove_source` (also TagRemovePreprocessor), hide-output is handled below
    (the preprocessor's own output removal would also blank the In [n] counter). -#}
{%- extends 'display_priority.j2' -%}

{%- block header -%}
{{ resources.jnb.head }}
{%- endblock header -%}

{%- block body_header -%}
<body>
{{ resources.jnb.top }}
<main class="jnb-article">
{%- endblock body_header -%}

{%- block body_footer -%}
</main>
{{ resources.jnb.bottom }}
{%- endblock body_footer -%}

{%- block footer -%}
{{ resources.jnb.scripts }}
</body>
</html>
{%- endblock footer -%}

{# ---- markdown ---------------------------------------------------------- #}
{%- block markdowncell scoped -%}
<div class="jnb-cell jnb-md">
{{ cell.source | markdown2html | jnb_callouts }}
</div>
{%- endblock markdowncell -%}

{%- block rawcell scoped -%}
{%- if cell.metadata.get('raw_mimetype', '').lower() in ['text/html', ''] -%}
<div class="jnb-cell jnb-raw">{{ cell.source }}</div>
{%- endif -%}
{%- endblock rawcell -%}

{# ---- code -------------------------------------------------------------- #}
{%- block codecell scoped -%}
<div class="jnb-cell jnb-code-cell{% for t in cell.metadata.get('tags', []) %} celltag_{{ t | escape_html }}{% endfor %}">
{{ super() }}
</div>
{%- endblock codecell -%}

{%- block input_group -%}
<div class="jnb-input">
<div class="jnb-file">{{ resources.jnb.file }}</div>
<div class="jnb-input-body">
{{ super() }}
</div>
</div>
{%- endblock input_group -%}

{%- block in_prompt -%}
<div class="jnb-prompt">In&nbsp;[{% if cell.execution_count is not none %}{{ cell.execution_count }}{% else %}&nbsp;{% endif %}]:</div>
{%- endblock in_prompt -%}

{%- block input -%}
<div class="jnb-code">
{{ cell.source | highlight_code(metadata=cell.metadata) | clean_html }}
</div>
{%- endblock input -%}

{%- block output_group -%}
{%- if 'hide-output' not in cell.metadata.get('tags', []) -%}
<div class="jnb-outputs">
{{ super() }}
</div>
{%- endif -%}
{%- endblock output_group -%}

{# outputs: the "Out [n]:" prompt is intentionally not rendered #}
{%- block output_prompt -%}{%- endblock output_prompt -%}

{%- block execute_result -%}
{%- block data_priority scoped -%}{{ super() }}{%- endblock data_priority -%}
{%- endblock execute_result -%}

{%- block stream_stdout -%}
<div class="jnb-output jnb-output--text"><pre>{{ output.text | ansi2html }}</pre></div>
{%- endblock stream_stdout -%}

{%- block stream_stderr -%}
<div class="jnb-output jnb-output--text jnb-output--stderr"><pre>{{ output.text | ansi2html }}</pre></div>
{%- endblock stream_stderr -%}

{%- block stream_stdin -%}{%- endblock stream_stdin -%}

{%- block data_text scoped -%}
<div class="jnb-output jnb-output--text"><pre>{{ output.data['text/plain'] | ansi2html }}</pre></div>
{%- endblock data_text -%}

{%- block data_html scoped -%}
<div class="jnb-output jnb-output--html">
{{ output.data['text/html'] }}
</div>
{%- endblock data_html -%}

{%- block data_markdown scoped -%}
<div class="jnb-output jnb-output--markdown">
{{ output.data['text/markdown'] | markdown2html | jnb_callouts }}
</div>
{%- endblock data_markdown -%}

{%- block data_latex scoped -%}
<div class="jnb-output jnb-output--latex">{{ output.data['text/latex'] | escape_html }}</div>
{%- endblock data_latex -%}

{%- block data_svg scoped -%}
<div class="jnb-output jnb-output--image"><img alt="" src="data:image/svg+xml;base64,{{ output.data['image/svg+xml'] | text_base64 | escape_html }}"></div>
{%- endblock data_svg -%}

{%- block data_png scoped -%}
<div class="jnb-output jnb-output--image"><img alt="" src="data:image/png;base64,{{ output.data['image/png'] | escape_html }}"></div>
{%- endblock data_png -%}

{%- block data_jpg scoped -%}
<div class="jnb-output jnb-output--image"><img alt="" src="data:image/jpeg;base64,{{ output.data['image/jpeg'] | escape_html }}"></div>
{%- endblock data_jpg -%}

{%- block data_javascript scoped -%}{%- endblock data_javascript -%}
{%- block data_widget_view scoped -%}{%- endblock data_widget_view -%}
{%- block data_pdf -%}{%- endblock data_pdf -%}
{%- block data_mermaid -%}{%- endblock data_mermaid -%}

{%- block error -%}
<div class="jnb-output jnb-output--text jnb-output--stderr"><pre>{{ super() }}</pre></div>
{%- endblock error -%}

{%- block traceback_line -%}
{{ (line | ansi2html) ~ "\n" }}
{%- endblock traceback_line -%}
