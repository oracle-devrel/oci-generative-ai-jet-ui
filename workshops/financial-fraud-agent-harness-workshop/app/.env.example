# Copy to .env and fill in real values.

# Flask
FLASK_PORT=8000
FLASK_DEBUG=false
FLASK_SECRET_KEY=change-me-to-a-random-string

# Oracle (must match the notebook's connection — same docker container, same users)
ORACLE_DSN=localhost:1521/FREEPDB1
ORACLE_SYS_USER=sys
ORACLE_SYS_PASS=OraclePwd_2025
ORACLE_AGENT_USER=AGENT
ORACLE_AGENT_PASS=AgentPwd_2025
ORACLE_DEMO_USER=FINANCE
ORACLE_DEMO_PASS=FinancePwd_2025
# Docker container bootstrap.py restarts when the vector pool needs a bounce
# (default oracle-free, as in .devcontainer/docker-compose.yml).
# ORACLE_CONTAINER=oracle-free

# In-DB ONNX embedder model (registered by app/scripts/bootstrap.py — leave as-is
# unless you've registered a different model)
ONNX_EMBED_MODEL=ALL_MINILM_L12_V2
ONNX_EMBED_DIM=384

# -----------------------------------------------------------------------------
# LLM — OCI GenAI, with an automatic, silent model fallback chain
# -----------------------------------------------------------------------------
# Lanes, tried in order (lanes whose env is missing are skipped):
#   1. grok-phx   LLM_MODEL @ OCI_GENAI_ENDPOINT          keys OCI_GENAI_API_KEY .. _6
#   2. grok-chi   LLM_MODEL @ OCI_GENAI_FALLBACK_ENDPOINT keys OCI_GENAI_FALLBACK_API_KEY .. _6
#   3. gptoss-chi OCI_GENAI_BACKUP_MODEL @ the Chicago endpoint, same Chicago keys
# A rate limit cools a lane for OCI_GENAI_FALLBACK_COOLDOWN_S and the next lane
# serves the call; switches are never shown in the UI. Events are appended as
# JSON lines to OCI_GENAI_ROUTER_LOG and printed as `[llm-router]` on the console.

LLM_MODEL=xai.grok-4.3

OCI_GENAI_API_KEY=replace-me-with-your-oci-genai-key
# OCI_GENAI_API_KEY_2=... up to _6
OCI_GENAI_ENDPOINT=https://inference.generativeai.us-phoenix-1.oci.oraclecloud.com/openai/v1

# Fallback region (optional; leave blank to run Phoenix only)
OCI_GENAI_FALLBACK_ENDPOINT=
OCI_GENAI_FALLBACK_API_KEY=
# OCI_GENAI_FALLBACK_API_KEY_2=... up to _6
OCI_GENAI_BACKUP_MODEL=openai.gpt-oss-120b
OCI_GENAI_FALLBACK_COOLDOWN_S=120
# OCI_GENAI_ROUTER_LOG=~/.cache/fraud-workshop/llm-router.log

# Agent loop
AGENT_MAX_ITERATIONS=8
AGENT_BUDGET_SECONDS=60

# OAMP scoping (these are the user_id / agent_id every memory is tagged with)
EDA_USER_ID=enterprise-operator
EDA_AGENT_ID=enterprise-data-agent

# Tavily — gives the agent real-time web/news access via the search_tavily tool.
# Get a key at https://app.tavily.com . Leave blank to disable the tool.
TAVILY_API_KEY=
